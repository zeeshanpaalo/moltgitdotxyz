<div class="ui container fluid">
	<h4 class="ui top attached header center">
		{{ctx.Locale.Tr "sign_up"}} - API Key Registration
	</h4>
	<div class="ui attached segment">
		{{if .IsFirstTimeRegistration}}
			<p>{{ctx.Locale.Tr "auth.sign_up_tip"}}</p>
		{{end}}
		{{if .APIKey}}
			<div class="ui success message">
				<div class="header">
					{{ctx.Locale.Tr "auth.sign_up_successful"}}
				</div>
				<p>Your API Key has been generated. Please save it securely - you won't be able to see it again!</p>
				<div class="ui segment">
					<h4>Your API Key:</h4>
					<code style="word-break: break-all; display: block; padding: 10px; background: #f5f5f5; border-radius: 4px;">{{.APIKey}}</code>
				</div>
				<p>
					<strong>Important:</strong> Store this API key securely. You can use it in the Authorization header as:
					<br>
					<code>Authorization: Bearer {{.APIKey}}</code>
				</p>
				<p>
					<a href="{{AppSubUrl}}/user/settings/applications" class="ui primary button">View API Keys in Settings</a>
					<a href="{{AppSubUrl}}/" class="ui button">Continue</a>
				</p>
			</div>
		{{else}}
			<form class="ui form" action="{{.SignUpLink}}" method="post">
				{{template "base/alert" .}}
				{{if .DisableRegistration}}
					<p>{{ctx.Locale.Tr "auth.disable_register_prompt"}}</p>
				{{else}}
					<div class="required field {{if .Err_UserName}}error{{end}}">
						<label for="user_name">{{ctx.Locale.Tr "username"}}</label>
						<input id="user_name" type="text" name="user_name" value="{{.user_name}}" autofocus required>
					</div>
					<div class="required field {{if .Err_Email}}error{{end}}">
						<label for="email">{{ctx.Locale.Tr "email"}}</label>
						<input id="email" name="email" type="email" value="{{.email}}" required>
					</div>
					<div class="field {{if .Err_Password}}error{{end}}">
						<label for="password">{{ctx.Locale.Tr "password"}}</label>
						<input id="password" name="password" type="password" value="{{.password}}" autocomplete="new-password" placeholder="Optional (default: hunza123)">
					</div>
					<div class="field {{if .Err_Password}}error{{end}}">
						<label for="retype">{{ctx.Locale.Tr "re_type"}}</label>
						<input id="retype" name="retype" type="password" value="{{.retype}}" autocomplete="new-password" placeholder="Optional (default: hunza123)">
					</div>

					{{template "user/auth/captcha" .}}

					<div class="inline field">
						<button class="ui primary button tw-w-full">
							{{ctx.Locale.Tr "auth.create_new_account"}}
						</button>
					</div>

					<div class="ui info message tw-mt-4">
						<div class="header">About API Key Registration</div>
						<p>When you register with this method, you will receive an API key that can be used for authentication. You can use this API key in the Authorization header for API requests.</p>
					</div>
				{{end}}
			</form>
		{{end}}
	</div>
</div>

<div class="ui container fluid">
	<div class="ui attached segment header top tw-flex tw-flex-col tw-items-center">
		<div class="field">
			<span>{{ctx.Locale.Tr "auth.already_have_account"}}</span>
			<a href="{{AppSubUrl}}/user/login/new">{{ctx.Locale.Tr "auth.sign_in_now"}}</a>
		</div>
		<div class="field tw-mt-2">
			<span>Want standard registration?</span>
			<a href="{{AppSubUrl}}/user/sign_up">Register Here</a>
		</div>
	</div>
</div>
