{{template "base/head" .}}
<div class="page-content user signup success">
	<div class="ui middle very relaxed page grid">
		<div class="column" style="max-width: 800px;">
			<div class="ui success message">
				<div class="header">
					{{ctx.Locale.Tr "auth.sign_up_successful"}}
				</div>
				<p>{{ctx.Locale.Tr "settings.api_key_created_successfully"}}</p>
			</div>
			
			<div class="ui attached info message">
				<h4 class="ui header">
					<i class="key icon"></i>
					{{ctx.Locale.Tr "settings.save_api_key"}}
				</h4>
				<p>{{ctx.Locale.Tr "settings.api_key_save_warning"}}</p>
			</div>
			
			<div class="ui attached segment">
				<div class="field">
					<label>{{ctx.Locale.Tr "settings.api_key"}}</label>
					<div class="ui action input">
						<input id="api-key-value" type="text" value="{{.APIKey}}" readonly>
						<button class="ui basic button" id="copy-api-key" data-content="{{ctx.Locale.Tr "copy_success"}}" data-variation="inverted tiny">
							<i class="copy icon"></i> {{ctx.Locale.Tr "copy"}}
						</button>
					</div>
				</div>
				
				<div class="ui warning message">
					<i class="warning icon"></i>
					{{ctx.Locale.Tr "settings.api_key_once_warning"}}
				</div>
			</div>
			
			<div class="ui attached segment">
				<h4 class="ui header">{{ctx.Locale.Tr "settings.how_to_use_api_key"}}</h4>
				<p>{{ctx.Locale.Tr "settings.api_key_usage_description"}}</p>
				<pre style="background: #f5f5f5; padding: 10px; border-radius: 4px;">curl -H "Authorization: Bearer {{.APIKey}}" \
  {{AppUrl}}api/v1/user/repos</pre>
			</div>
			
			<div class="ui bottom attached segment">
				<form action="{{AppSubUrl}}/user/login/new" method="POST">
					{{.CsrfTokenHtml}}
					<input type="hidden" name="api_key" value="{{.APIKey}}">
					<button class="ui primary fluid button">
						{{ctx.Locale.Tr "auth.sign_in_now"}}
					</button>
				</form>
			</div>
		</div>
	</div>
</div>

<script>
document.getElementById('copy-api-key').addEventListener('click', function() {
	const input = document.getElementById('api-key-value');
	input.select();
	document.execCommand('copy');
	
	const btn = this;
	const originalText = btn.innerHTML;
	btn.innerHTML = '<i class="check icon"></i> Copied!';
	btn.classList.add('green');
	
	setTimeout(function() {
		btn.innerHTML = originalText;
		btn.classList.remove('green');
	}, 2000);
});
</script>

{{template "base/footer" .}}
